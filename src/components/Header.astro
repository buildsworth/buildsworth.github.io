---
import { nav, site } from "../data/site";
---

<header class="site-header" data-header>
  <span class="site-header__bg" aria-hidden="true"></span>
  <a class="brand" href="/" aria-label="BuildsWorth home">
    <img src="/brand/logo.png" alt="" width="160" height="64" />
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
    <span class="sr">Menu</span>
    <span class="nav-toggle__bars" aria-hidden="true"></span>
  </button>
  <nav id="site-nav" class="site-nav" data-nav>
    {
      nav.map((item) => (
        <a href={item.href} data-nav-link>
          {item.label}
        </a>
      ))
    }
    <a class="nav-call" href={`tel:${site.phoneTel}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 7a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1L6.6 10.8z"></path>
      </svg>
      {site.phoneDisplay}
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  const setOpen = (open: boolean) => {
    document.body.classList.toggle("nav-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  const onScroll = () => {
    header?.classList.toggle("is-stuck", window.scrollY > 12);
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });
  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>
